#intro { gap: 0 !important; }

#hero { padding: 26px 6px 4px; text-align: left; }
#hero .eyebrow {
    display: inline-block; font-size: 10.5px; letter-spacing: .22em; color: #777;
    border: 1px solid var(--line); background: rgba(255,255,255,.75);
    border-radius: 999px; padding: 6px 14px; margin-bottom: 24px;
}
#hero h1 {
    font-weight: 800;
    font-size: clamp(40px, 6vw, 104px);
    line-height: 1.06;
    letter-spacing: -.03em;
    margin: 0 0 16px;
    color: var(--ink);
}
#hero h1 .g { color: var(--gray); }
#hero .dash { width: 26px; height: 2px; background: var(--ink); margin: 4px 0 18px; }
#hero p { color: #8a8a8a; font-size: 15px; line-height: 1.8; max-width: 380px; margin: 0; }

#start-btn {
    width: auto !important; flex-grow: 0 !important; align-self: flex-start;
    background: var(--ink) !important; color: #fff !important;
    border-radius: 999px !important; padding: 14px 30px !important;
    font-weight: 600 !important; font-size: 14px !important;
    margin: 8px 0 0 6px;
}
#start-btn:hover { background: #2b2b2b !important; }

/* ภาพประกอบ */
#visual { position: relative; height: 440px; }
#visual .ring {
    position: absolute; left: 50%; top: 10px; width: 340px; height: 340px;
    margin-left: -170px; border-radius: 50%;
    border: 1.5px solid rgba(255,255,255,.98);
    box-shadow: 0 0 0 1px rgba(0,0,0,.04), 0 0 80px rgba(255,255,255,.95);
}
#visual .arch {
    position: absolute; left: 50%; top: 40px; width: 270px; height: 270px;
    margin-left: -135px; border-radius: 50%;
    background:
        repeating-linear-gradient(90deg, rgba(0,0,0,.05) 0 2px, rgba(255,255,255,0) 2px 9px),
        linear-gradient(180deg, #ffffff 0%, #efefef 100%);
    -webkit-mask-image: linear-gradient(180deg, #000 55%, transparent 100%);
            mask-image: linear-gradient(180deg, #000 55%, transparent 100%);
}
#visual .pedestal {
    position: absolute; left: 50%; bottom: 10px; width: 320px; height: 66px;
    margin-left: -160px; border-radius: 50%;
    background: radial-gradient(ellipse at 50% 30%, #ffffff 0%, #e6e6e6 70%);
    box-shadow: 0 24px 40px rgba(0,0,0,.12);
}
#visual .sphere {
    position: absolute; left: 50%; bottom: 54px; width: 150px; height: 150px;
    margin-left: -75px; border-radius: 50%; z-index: 2;
    background:
        radial-gradient(circle at 30% 26%, rgba(255,255,255,.95) 0%, rgba(255,255,255,0) 28%),
        radial-gradient(circle at 70% 78%, rgba(255,255,255,.18) 0%, rgba(255,255,255,0) 40%),
        radial-gradient(circle at 50% 50%, #3a3a3a 0%, #0b0b0b 75%);
    box-shadow: 0 26px 36px rgba(0,0,0,.28), inset 0 -8px 18px rgba(255,255,255,.08);
    animation: float 5s ease-in-out infinite;
}
#visual .sphere .lens {
    position: absolute; right: 14px; top: 56px; width: 20px; height: 20px;
    border-radius: 50%; background: #111; border: 3px solid #e8e8e8;
}
#visual .index {
    position: absolute; right: 0; top: 130px;
    display: flex; flex-direction: column; align-items: flex-end; gap: 8px;
    font-size: 12px; color: #b3b3b3;
}
#visual .index b { color: var(--ink); font-size: 13px; }
#visual .index i { width: 2px; height: 44px; background: var(--ink); display: block; }
@keyframes float {
    0%, 100% { transform: translateY(0); }
    50%      { transform: translateY(-8px); }
}

/* แถบหัวข้อแนะนำด้านล่าง */
#strip {
    background: rgba(255,255,255,.8) !important;
    border: 1px solid #ebebeb !important;
    border-radius: 24px !important;
    padding: 8px !important;
    gap: 0 !important;
    margin-top: 10px;
}
.pcard, .pcard button, button.pcard {
    background: transparent !important;
    border: none !important;
    border-right: 1px solid #ececec !important;
    border-radius: 0 !important;
    color: #8a8a8a !important;
    box-shadow: none !important;
    padding: 16px 18px !important;
    min-height: 76px;
    text-align: left !important;
    white-space: pre-line !important;
    font-size: 12px !important;
    font-weight: 400 !important;
    line-height: 1.6 !important;
    transition: background .2s;
}
.pcard::first-line, button.pcard::first-line {
    color: var(--ink); font-size: 14px; font-weight: 700;
}
.pcard:last-child, button.pcard:last-child { border-right: none !important; }
.pcard:hover { background: rgba(0,0,0,.04) !important; border-radius: 16px !important; }

/* ---------------- แชต ---------------- */
#chatbot { height: calc(100vh - 250px) !important; min-height: 320px; }

.gradio-container [class*="chatbot"], .gradio-container .chatbot {
    background: transparent !important; border: none !important;
}
.message.user, [data-testid="user"] {
    background: var(--ink) !important; color: #fff !important;
    border-radius: 20px 20px 6px 20px !important;
}
.message.bot, [data-testid="bot"] {
    background: #ffffff !important; color: var(--ink) !important;
    border: 1px solid var(--line) !important;
    border-radius: 20px 20px 20px 6px !important;
    box-shadow: 0 8px 22px rgba(0,0,0,.05);
}
.message.user *, [data-testid="user"] * { color: #fff !important; }

/* กันกล่องซ้อนกันในฟองแชต */
[data-testid="bot"] [data-testid="bot"],
[data-testid="bot"] .message.bot,
.message.bot .message.bot,
.message.bot [data-testid="bot"],
[data-testid="user"] [data-testid="user"],
[data-testid="user"] .message.user,
.message.user .message.user,
.message.user [data-testid="user"],
.message.bot .prose, .message.bot .md, .message.bot span,
.message.user .prose, .message.user .md, .message.user span {
    background: transparent !important; border: none !important;
    box-shadow: none !important; padding-top: 0 !important; padding-bottom: 0 !important;
}
.message.bot span, .message.user span { border-radius: 0 !important; }
.message img.emoji, .message .md img, .message .prose img {
    background: transparent !important; border: none !important;
    box-shadow: none !important; padding: 0 !important;
}
.message.bot pre, .message.bot code { background: #f1f1f1 !important; }

/* ปุ่มคัดลอก / แชร์ / ลบ */
.message-buttons, .message-buttons-left, .message-buttons-right,
.message-buttons-bubble, .message-buttons-panel {
    background: transparent !important; border: none !important; box-shadow: none !important;
}
.message-buttons button, .message-buttons .icon-button,
button.icon-button, .copy-button, .message button[aria-label] {
    background: transparent !important; border: none !important; box-shadow: none !important;
    color: #666 !important; border-radius: 8px !important; min-width: 0 !important;
}
.message-buttons button:hover, button.icon-button:hover { background: rgba(0,0,0,.06) !important; }
.message-buttons svg, button.icon-button svg, .copy-button svg {
    stroke: currentColor !important; color: #666 !important;
}
.icon-button-wrapper {
    border: none !important; background: transparent !important; box-shadow: none !important;
}

/* ---------------- ช่องพิมพ์ ---------------- */
#input-row { align-items: center; gap: 8px; margin-top: 10px; }
#input-row textarea {
    border-radius: 999px !important; padding: 13px 20px !important;
    background: #ffffff !important; color: var(--ink) !important;
    border: 1px solid var(--line) !important;
}
#attach-btn, #send-btn {
    min-width: 48px !important; max-width: 52px; height: 48px;
    border-radius: 50% !important; padding: 0 !important;
}
#send-btn { background: var(--ink) !important; color: #fff !important; }
#attach-btn { background: #fff !important; border: 1px solid var(--line) !important; }

#attach-info { font-size: 12px; color: #555; padding: 2px 6px; }
#attach-info p { margin: 0; }
#clear-btn {
    background: #fff !important; border: 1px solid var(--line) !important; color: var(--ink) !important;
}

/* ---------------- แผงตั้งค่าด้านขวา ---------------- */
#side-panel {
    background: rgba(255,255,255,.88) !important;
    border: 1px solid var(--line) !important;
    border-radius: 24px !important;
    padding: 16px !important; gap: 10px !important;
    align-self: flex-start;
    box-shadow: 0 10px 30px rgba(0,0,0,.05);
}
#side-panel .side-title { font-weight: 700; font-size: 15px; color: var(--ink); margin-bottom: 4px; }
#side-panel .block, #side-panel .form, #side-panel fieldset,
#side-panel .wrap, #side-panel .container {
    background: transparent !important; border: none !important; box-shadow: none !important;
}
#side-panel label, #side-panel label span,
#side-panel span[data-testid="block-info"], #side-panel .block-title {
    background: transparent !important; color: #333 !important;
}
#side-panel input[type="text"], #side-panel .wrap-inner {
    background: #fff !important; border: 1px solid var(--line) !important;
    color: var(--ink) !important; border-radius: 14px !important;
}
#side-panel input[type="checkbox"] {
    background-color: #fff !important; border: 1px solid #b5b5b5 !important; accent-color: #111;
}
#side-panel input[type="checkbox"]:checked {
    background-color: #111 !important; border-color: #111 !important;
}
#new-btn {
    background: var(--ink) !important; color: #fff !important;
    border-radius: 999px !important; font-weight: 600 !important; margin-top: 6px;
}

@media (max-width: 800px) {
    #topbar { grid-template-columns: 1fr auto; }
    #topbar .navpill { display: none; }
    #visual { height: 300px; }
    #visual .index { display: none; }
    #strip { flex-wrap: wrap; }
}
"""


# =========================================================
# 7. ฟังก์ชันของหน้าเว็บ
# =========================================================

# (ชื่อหัวข้อ, คำอธิบายสั้นใต้ชื่อ, คำถามที่ส่งเมื่อกด)
POPULAR = [
    ("💡 อธิบาย AI", "เรียนรู้ ML แบบง่ายๆ",
     "อธิบาย Machine Learning ให้เข้าใจง่ายสำหรับผู้เริ่มต้น"),
    ("🐍 เขียนโค้ด Python", "อ่านและสรุปไฟล์ CSV",
     "ช่วยเขียนโค้ด Python อ่านไฟล์ CSV และสรุปข้อมูล"),
    ("🔬 วิทยาศาสตร์", "แบตเตอรี่ลิเธียมไอออน",
     "อธิบายหลักการทำงานของแบตเตอรี่ลิเธียมไอออน"),
    ("🤖 Automation", "ลดงานซ้ำด้วย Python",
     "แนะนำวิธีทำ automation ลดงานซ้ำๆ ด้วย Python"),
]


def update_language(language):
    t = get_page_text(language)
    return (
        make_topbar(language),
        make_header(language),
        gr.update(placeholder=t["placeholder"]),
        gr.update(value=t["start"]),
    )


def respond(message, history, language, use_search, use_kb, deep_think, files):
    message = (message or "").strip()
    history = history or []
    files = files or []

    # แนบไฟล์แต่ไม่พิมพ์อะไร -> ให้สรุปไฟล์
    if not message and files:
        message = (
            "Please summarize the attached file(s)."
            if language == LANG_EN
            else "ช่วยสรุปเนื้อหาของไฟล์ที่แนบมา"
        )

    if not message:
        yield history, ""
        return

    shown = history + [{"role": "user", "content": message}]
    yield shown, ""

    for partial in chat(
        message, history, language, use_search, use_kb, deep_think, files
    ):
        yield shown + [{"role": "assistant", "content": partial}], ""


def show_chat():
    """ซ่อนหน้าแรก แล้วแสดงกล่องแชต"""
    return gr.update(visible=False), gr.update(visible=True)


def new_chat():
    """กลับหน้าแรก ล้างแชตและไฟล์แนบ"""
    return (
        gr.update(value=[], visible=False),   # chatbot (ล้างและซ่อน)
        gr.update(visible=True),              # intro
        [],                                   # files_state
        gr.update(value="", visible=False),   # attach_info
        gr.update(visible=False),             # clear_btn
        "",                                   # box
    )


# =========================================================
# 8. สร้างหน้าแชต
# =========================================================

blocks_kwargs = {"title": "Local AI"}
launch_kwargs = {}
chatbot_kwargs = {"elem_id": "chatbot", "show_label": False}

if GR_MAJOR >= 6:
    launch_kwargs.update(theme=THEME, css=CSS)
else:
    blocks_kwargs.update(theme=THEME, css=CSS)
    chatbot_kwargs["type"] = "messages"

FOCUS_JS = (
    "() => setTimeout(() => { "
    "const t = document.querySelector('#input-row textarea'); "
    "if (t) t.focus(); }, 250)"
)

with gr.Blocks(**blocks_kwargs) as demo:
    topbar = gr.HTML(make_topbar(LANG_THAI))
    files_state = gr.State([])            # ไฟล์ที่แนบไว้ในแชตนี้

    with gr.Row(equal_height=False):
        # ================= ซ้าย: หน้าแรก / แชต / ช่องพิมพ์ =================
        with gr.Column(scale=4, min_width=360):

            # ---------- หน้าแรก (ซ่อนเมื่อเริ่มแชต) ----------
            with gr.Column(elem_id="intro") as intro:
                with gr.Row(equal_height=False):
                    with gr.Column(scale=3, min_width=300):
                        header = gr.HTML(make_header(LANG_THAI))
                        start_btn = gr.Button(
                            get_page_text(LANG_THAI)["start"],
                            elem_id="start-btn",
                            scale=0,
                        )
                    with gr.Column(scale=2, min_width=240):
                        gr.HTML(make_visual())

                with gr.Row(elem_id="strip"):
                    card_btns = [
                        gr.Button(f"{title}\n{sub}", elem_classes="pcard", min_width=160)
                        for title, sub, _ in POPULAR
                    ]

            # ---------- แชต (แสดงเมื่อเริ่มแชต) ----------
            chatbot = gr.Chatbot(visible=False, **chatbot_kwargs)

            with gr.Row():
                attach_info = gr.Markdown("", visible=False, elem_id="attach-info")
                clear_btn = gr.Button(
                    "✖ ล้างไฟล์", visible=False, size="sm",
                    elem_id="clear-btn", scale=0, min_width=110,
                )

            # ---------- ช่องพิมพ์ ----------
            with gr.Row(elem_id="input-row"):
                attach = gr.UploadButton(
                    "📎",
                    file_count="multiple",
                    file_types=FILE_TYPES,
                    elem_id="attach-btn",
                    scale=1,
                    min_width=48,
                )
                box = gr.Textbox(
                    placeholder=get_page_text(LANG_THAI)["placeholder"],
                    show_label=False,
                    lines=1,
                    max_lines=5,
                    scale=8,
                    container=False,
                )
                send = gr.Button("➤", variant="primary", elem_id="send-btn", scale=1)

        # ================= ขวา: ตั้งค่า =================
        with gr.Column(scale=1, min_width=230, elem_id="side-panel"):
            gr.HTML('<div class="side-title">⚙️ ตั้งค่า / Settings</div>')
            language = gr.Dropdown(
                choices=[LANG_THAI, LANG_EN, LANG_AUTO],
                value=LANG_THAI,
                label="ภาษา / Language",
            )
            use_search = gr.Checkbox(label="🔎 ค้นหาเว็บ", value=False)
            use_kb = gr.Checkbox(label="📚 ใช้ฐานความรู้ในเครื่อง", value=False)
            deep_think = gr.Checkbox(label="🧠 คิดลึก (ช้ากว่า)", value=False)
            new_btn = gr.Button("✚ แชตใหม่ / New chat", elem_id="new-btn")

    chat_inputs = [box, chatbot, language, use_search, use_kb, deep_think, files_state]

    # ส่งข้อความ (Enter / ปุ่มส่ง)
    for trigger in (box.submit, send.click):
        trigger(show_chat, outputs=[intro, chatbot], queue=False).then(
            respond, inputs=chat_inputs, outputs=[chatbot, box]
        )

    # กดการ์ดหัวข้อ -> ใส่คำถามแล้วส่งเลย
    for btn, (_, _, prompt) in zip(card_btns, POPULAR):
        btn.click(lambda p=prompt: p, outputs=box, queue=False).then(
            show_chat, outputs=[intro, chatbot], queue=False
        ).then(respond, inputs=chat_inputs, outputs=[chatbot, box])

    # ปุ่มเริ่มแชต -> ไปหน้าแชต แล้วโฟกัสช่องพิมพ์
    start_btn.click(show_chat, outputs=[intro, chatbot], queue=False).then(
        None, None, None, js=FOCUS_JS
    )

    # แนบไฟล์ / ล้างไฟล์
    attach.upload(
        attach_files,
        inputs=[attach, files_state],
        outputs=[files_state, attach_info, clear_btn, attach],
    )
    clear_btn.click(
        clear_files,
        outputs=[files_state, attach_info, clear_btn],
    )

    # แชตใหม่
    new_btn.click(
        new_chat,
        outputs=[chatbot, intro, files_state, attach_info, clear_btn, box],
        queue=False,
    )

    # เปลี่ยนภาษา
    language.change(
        update_language,
        inputs=[language],
        outputs=[topbar, header, box, start_btn],
        queue=False,
    )


if __name__ == "__main__":
    HOST, PORT = "127.0.0.1", 7860
    demo.queue()

    try:
        import webview        # pip install pywebview
    except ImportError:
        webview = None

    if webview is None:
        print("[Local AI] ไม่พบ pywebview -> เปิดในเบราว์เซอร์แทน "
              "(อยากได้หน้าต่างโปรแกรม: pip install pywebview)")
        demo.launch(server_name=HOST, server_port=PORT, share=False, **launch_kwargs)
    else:
        # เปิดเซิร์ฟเวอร์เบื้องหลัง แล้วแสดงในหน้าต่างโปรแกรมของ Windows
        demo.launch(
            server_name=HOST,
            server_port=PORT,
            share=False,
            inbrowser=False,
            prevent_thread_lock=True,
            **launch_kwargs,
        )
        webview.create_window(
            "Local AI",
            f"http://{HOST}:{PORT}",
            width=1920,
            height=1080,
            resizable=True,
            min_size=(480, 600),
        )
        webview.start()       # ปิดหน้าต่างแล้วโปรแกรมจะจบการทำงาน
        demo.close()